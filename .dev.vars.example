# Copy this file to .dev.vars and fill in your key for LOCAL development.
# For production, set the same values as Cloudflare Worker Secrets instead
# (never commit .dev.vars).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (defaults to gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Translation API (separate key/model from auto-posting — used when the UI is
# switched to English to translate article bodies on the fly)
TRANSLATION_API_KEY=your_translation_gemini_key_here
TRANSLATION_MODEL=gemini-3.1-flash-lite

# OpenRouter AI article writing (admin -> /admin/ai).
# Only :free models are accepted; there is no paid fallback. The key is read
# by the Worker only and is never sent to the browser.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: force a specific free model. When set, it overrides the value
# saved in the admin screen. Must end with ":free".
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
